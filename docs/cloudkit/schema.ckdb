DEFINE SCHEMA

    RECORD TYPE CD_ActionItem (
        CD_createdAt    TIMESTAMP QUERYABLE SORTABLE,
        CD_details      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_doneAt       TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isDone       INT64 QUERYABLE SORTABLE,
        CD_kindRaw      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_noteID       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_order        INT64 QUERYABLE SORTABLE,
        CD_owner        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_reviewRaw    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_source       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_updatedAt    TIMESTAMP QUERYABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ChatEntry (
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isError             INT64 QUERYABLE SORTABLE,
        CD_roleRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_roleRaw_ckAsset     ASSET,
        CD_sourcesData         BYTES QUERYABLE SORTABLE,
        CD_sourcesData_ckAsset ASSET,
        CD_text                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text_ckAsset        ASSET,
        CD_threadID            STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ChatThread (
        CD_createdAt         TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_projectID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_projectID_ckAsset ASSET,
        CD_title             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset     ASSET,
        CD_updatedAt         TIMESTAMP QUERYABLE SORTABLE,
        "___createTime"      TIMESTAMP,
        "___createdBy"       REFERENCE,
        "___etag"            STRING,
        "___modTime"         TIMESTAMP,
        "___modifiedBy"      REFERENCE,
        "___recordID"        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Meeting (
        CD_audioFileName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_audioFileName_ckAsset  ASSET,
        CD_channelCount           INT64 QUERYABLE SORTABLE,
        CD_createdAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_duration               DOUBLE QUERYABLE SORTABLE,
        CD_entityName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_errorMessage           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_errorMessage_ckAsset   ASSET,
        CD_id                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_inputName              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_inputName_ckAsset      ASSET,
        CD_migrated               INT64 QUERYABLE SORTABLE,
        CD_segmentsData           BYTES QUERYABLE SORTABLE,
        CD_segmentsData_ckAsset   ASSET,
        CD_speakerModeRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_speakerModeRaw_ckAsset ASSET,
        CD_speakersData           BYTES QUERYABLE SORTABLE,
        CD_speakersData_ckAsset   ASSET,
        CD_statusRaw              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_statusRaw_ckAsset      ASSET,
        CD_summarizedAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_summary                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_summaryModel           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_summaryModel_ckAsset   ASSET,
        CD_summary_ckAsset        ASSET,
        CD_title                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_titleIsCustom          INT64 QUERYABLE SORTABLE,
        CD_title_ckAsset          ASSET,
        "___createTime"           TIMESTAMP,
        "___createdBy"            REFERENCE,
        "___etag"                 STRING,
        "___modTime"              TIMESTAMP,
        "___modifiedBy"           REFERENCE,
        "___recordID"             REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Note (
        CD_archivedAt                   TIMESTAMP QUERYABLE SORTABLE,
        CD_attachmentsData              BYTES QUERYABLE SORTABLE,
        CD_attachmentsData_ckAsset      ASSET,
        CD_audioFileName                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_audioFileName_ckAsset        ASSET,
        CD_audioFileNames               BYTES QUERYABLE SORTABLE,
        CD_audioFileNames_ckAsset       ASSET,
        CD_channelCount                 INT64 QUERYABLE SORTABLE,
        CD_createdAt                    TIMESTAMP QUERYABLE SORTABLE,
        CD_deletedAt                    TIMESTAMP QUERYABLE SORTABLE,
        CD_duration                     DOUBLE QUERYABLE SORTABLE,
        CD_entityName                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_errorMessage                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_errorMessage_ckAsset         ASSET,
        CD_filedAt                      TIMESTAMP QUERYABLE SORTABLE,
        CD_folderID                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_inputName                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_inputName_ckAsset            ASSET,
        CD_isPinned                     INT64 QUERYABLE SORTABLE,
        CD_labels                       BYTES QUERYABLE SORTABLE,
        CD_labels_ckAsset               ASSET,
        CD_pageText                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_pageText_ckAsset             ASSET,
        CD_pendingAudioFileName         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_pendingAudioFileName_ckAsset ASSET,
        CD_projectIDs                   BYTES QUERYABLE SORTABLE,
        CD_projectIDs_ckAsset           ASSET,
        CD_segmentsData                 BYTES QUERYABLE SORTABLE,
        CD_segmentsData_ckAsset         ASSET,
        CD_shareCopyToken               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_shareCopyToken_ckAsset       ASSET,
        CD_sourceRaw                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceRaw_ckAsset            ASSET,
        CD_speakerModeRaw               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_speakerModeRaw_ckAsset       ASSET,
        CD_speakersData                 BYTES QUERYABLE SORTABLE,
        CD_speakersData_ckAsset         ASSET,
        CD_statusRaw                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_statusRaw_ckAsset            ASSET,
        CD_suggestedProjectIDs          BYTES QUERYABLE SORTABLE,
        CD_suggestedProjectIDs_ckAsset  ASSET,
        CD_summarizedAt                 TIMESTAMP QUERYABLE SORTABLE,
        CD_summary                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_summaryModel                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_summaryModel_ckAsset         ASSET,
        CD_summary_ckAsset              ASSET,
        CD_text                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text_ckAsset                 ASSET,
        CD_title                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_titleIsCustom                INT64 QUERYABLE SORTABLE,
        CD_title_ckAsset                ASSET,
        CD_todoDoneAt                   TIMESTAMP QUERYABLE SORTABLE,
        CD_todoDueDay                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_todoDueDay_ckAsset           ASSET,
        CD_todoSourceID                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_todoSourceID_ckAsset         ASSET,
        CD_todoStateRaw                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_todoStateRaw_ckAsset         ASSET,
        CD_todoSuggestionsRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_todoSuggestionsRaw_ckAsset   ASSET,
        CD_updatedAt                    TIMESTAMP QUERYABLE SORTABLE,
        CD_url                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_url_ckAsset                  ASSET,
        "___createTime"                 TIMESTAMP,
        "___createdBy"                  REFERENCE,
        "___etag"                       STRING,
        "___modTime"                    TIMESTAMP,
        "___modifiedBy"                 REFERENCE,
        "___recordID"                   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_NoteFolder (
        CD_archivedAt   TIMESTAMP QUERYABLE SORTABLE,
        CD_createdAt    TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isPinned     INT64 QUERYABLE SORTABLE,
        CD_name         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset ASSET,
        CD_parentID     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_shareCopyToken STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_shareCopyToken_ckAsset ASSET,
        CD_updatedAt    TIMESTAMP QUERYABLE SORTABLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_VoiceProfile (
        CD_entityName        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset      ASSET,
        CD_seconds           DOUBLE QUERYABLE SORTABLE,
        CD_updatedAt         TIMESTAMP QUERYABLE SORTABLE,
        CD_voiceData         BYTES QUERYABLE SORTABLE,
        CD_voiceData_ckAsset ASSET,
        "___createTime"      TIMESTAMP,
        "___createdBy"       REFERENCE,
        "___etag"            STRING,
        "___modTime"         TIMESTAMP,
        "___modifiedBy"      REFERENCE,
        "___recordID"        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SharedBowl (
        bowlID          STRING,
        name            STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SharedFile (
        file            ASSET,
        fileName        STRING,
        kind            STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SharedNote (
        noteID          STRING,
        payload         BYTES,
        payloadAsset    ASSET,
        updatedAt       TIMESTAMP,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE "cloudkit.share" (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
