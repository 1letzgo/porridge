<?xml version="1.0" encoding="utf-8"?>
<!--
  Nichts verlässt das Gerät über Android-Backup oder den Umzug auf ein neues Gerät (android:allowBackup="false" gilt
  ab Android 12 nicht mehr für den Umzug). Vor allem porridge.secure.xml darf nicht mit: Sein Schlüssel liegt im
  Keystore dieses Geräts, auf einem anderen ließe sich die Datei nicht öffnen. Abgeglichen wird über Nextcloud.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
